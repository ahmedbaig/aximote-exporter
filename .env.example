# Copy to .env and fill in. Never commit the real file.

# Personal access token from the Aximote app (needs Aximote Pro). The only
# credential the exporter uses.
AXIMOTE_TOKEN=

# History in Postgres. Leave empty to run metrics-only (no map, trips or costs).
# With `--profile history` or `--profile stack` use the bundled database:
# AXIMOTE_PG_DSN=postgresql://aximote:change-me@postgres:5432/aximote
AXIMOTE_PG_DSN=

# Used by the bundled Postgres and Grafana. Change both before first start.
AXIMOTE_PG_PASSWORD=change-me
GRAFANA_PASSWORD=admin

# Your time zone, for "first trip of the day" and other clock-time analytics.
AXIMOTE_TZ=UTC

# Polling. The in-car agent updates far less often than this and the API
# returns 429 if you push it, so faster buys nothing.
AXIMOTE_STATE_INTERVAL=180
AXIMOTE_EVENT_INTERVAL=300

# Optional
AXIMOTE_METRICS_PORT=9684
AXIMOTE_BACKFILL=true
AXIMOTE_STATE_SAMPLES=true
AXIMOTE_LOG_LEVEL=INFO

# Telegram, for docs/alerting.md (Alertmanager or Grafana-managed alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
